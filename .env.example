# CoreValley console - authentication
#
# Copy to .env.local. As committed this file points at the local Keycloak realm
# started by docker compose, which is the normal way to run the console:
#
#   docker compose up -d      # starts Keycloak + Postgres, imports the realm
#   cp .env.example .env.local
#   npm run dev
#
# The server refuses to start unless it can actually authenticate someone - it
# will not silently fall back to a mode that signs everyone in. That means one
# of the two blocks below must be satisfied, and AUTH_SECRET is always needed.

# ---------------------------------------------------------------------------
# Keycloak
# ---------------------------------------------------------------------------

# Must include the realm path. Its presence is what selects Keycloak mode.
KEYCLOAK_ISSUER=http://localhost:8080/realms/corevalley
KEYCLOAK_CLIENT_ID=corevalley-portal
KEYCLOAK_CLIENT_SECRET=corevalley-portal-dev-secret

# ---------------------------------------------------------------------------
# Mock mode (development only)
# ---------------------------------------------------------------------------

# To run the console with no Keycloak at all, comment out KEYCLOAK_ISSUER above
# and uncomment this. The sign-in button then issues a session to whoever clicks
# it, with no credential check of any kind - which is why it has to be asked for
# by name. It is rejected outright under NODE_ENV=production, so it can never
# become the accidental configuration of a real deployment.
# AUTH_ALLOW_MOCK=true

# ---------------------------------------------------------------------------
# NextAuth
# ---------------------------------------------------------------------------

# Signs and encrypts the session cookie. Required for every server build,
# including mock mode - there is no built-in default, because a default in a
# public repository is a key everyone already has.
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=replace-me-with-a-32-byte-random-string

# The canonical origin of this app. Keycloak's redirect URI must match it.
NEXTAUTH_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Build target
# ---------------------------------------------------------------------------

# "true" produces the static ./out bundle for GitHub Pages. A static export has
# no server: middleware and /api/auth are dropped, no session cookie exists, and
# the console renders a read-only demo identity baked in at build time. The
# guards above do not apply to it. Leave unset for `npm run dev` and any server
# deployment.
# NEXT_STATIC_EXPORT=true
