{
  "name": "corevalley-web-portal",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "predev": "node scripts/prepare-content.mjs --dev",
    "dev": "next dev",
    "prebuild": "node scripts/prepare-content.mjs",
    "build": "next build",
    "postbuild": "node scripts/postbuild-content.mjs",
    "build:docs": "node scripts/build-docs-site.mjs",
    "docs:mkdocs": "mkdocs build -f corevalley-docs/mkdocs.yml --clean",
    "docs:mkdocs:serve": "mkdocs serve -f corevalley-docs/mkdocs.yml -a 127.0.0.1:8001",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "generate:brand": "node scripts/generate-brand-images.mjs",
    "serve:out": "node scripts/serve-out.mjs",
    "audit:a11y": "node scripts/audit-a11y.mjs"
  },
  "dependencies": {
    "@payloadcms/live-preview": "^3.90.2",
    "@phosphor-icons/react": "2.1.10",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "minisearch": "^7.2.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "3.3.1",
    "unist-util-visit": "^5.1.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@fontsource/inter": "5.2.8",
    "@tailwindcss/postcss": "4.3.3",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "22.18.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/unist": "^3.0.3",
    "axe-core": "4.14.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "4.3.3",
    "typescript": "~5.9.2"
  }
}
